{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "cat-backdrop",
  "type": "registry:component",
  "title": "Cat Backdrop",
  "description": "将卡通黑白猫安全地放在页面或卡片背景中，并为正文保留清晰区域。",
  "files": [
    {
      "path": "src/components/custom/cat-backdrop.tsx",
      "target": "src/components/custom/cat-backdrop.tsx",
      "type": "registry:component",
      "content": "import * as React from \"react\"\nimport { cn } from \"cn\"\nimport catMascot from \"./cat-mascot-data\"\nimport \"./cat-backdrop.css\"\n\ntype CatBackdropProps = React.ComponentProps<\"section\"> & {\n  variant?: \"page\" | \"card\"\n  imageClassName?: string\n}\n\nfunction CatBackdrop({\n  variant = \"card\",\n  className,\n  imageClassName,\n  children,\n  ...props\n}: CatBackdropProps) {\n  return (\n    <section\n      data-slot=\"cat-backdrop\"\n      data-variant={variant}\n      className={cn(\"cat-backdrop\", className)}\n      {...props}\n    >\n      <div className=\"cat-backdrop__content\">{children}</div>\n      <img\n        className={cn(\"cat-backdrop__mascot\", imageClassName)}\n        src={catMascot}\n        alt=\"\"\n        aria-hidden=\"true\"\n      />\n    </section>\n  )\n}\n\nexport { CatBackdrop }\nexport type { CatBackdropProps }\n"
    },
    {
      "path": "src/components/custom/cat-backdrop.css",
      "target": "src/components/custom/cat-backdrop.css",
      "type": "registry:file",
      "content": ".cat-backdrop {\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: var(--surface-radius);\n  background: var(--card);\n  color: var(--card-foreground);\n  box-shadow: var(--design-shadow);\n}\n\n.cat-backdrop::after {\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  content: \"\";\n  pointer-events: none;\n}\n\n.cat-backdrop__content {\n  position: relative;\n  z-index: 1;\n}\n\n.cat-backdrop__mascot {\n  position: absolute;\n  z-index: -2;\n  right: -5%;\n  bottom: -19%;\n  width: 48%;\n  max-width: 31rem;\n  pointer-events: none;\n  user-select: none;\n}\n\n.cat-backdrop[data-variant=\"page\"] {\n  min-height: 22rem;\n}\n\n.cat-backdrop[data-variant=\"page\"]::after {\n  background: linear-gradient(90deg, var(--card) 0%, var(--card) 48%, transparent 75%);\n}\n\n.cat-backdrop[data-variant=\"page\"] .cat-backdrop__content {\n  width: min(60%, 40rem);\n  padding: clamp(1.75rem, 4vw, 3.5rem);\n}\n\n.cat-backdrop[data-variant=\"card\"] {\n  min-height: 13rem;\n}\n\n.cat-backdrop[data-variant=\"card\"]::after {\n  background: linear-gradient(90deg, var(--card) 0%, var(--card) 55%, transparent 82%);\n}\n\n.cat-backdrop[data-variant=\"card\"] .cat-backdrop__content {\n  width: 68%;\n  padding: 1.5rem;\n}\n\n.cat-backdrop[data-variant=\"card\"] .cat-backdrop__mascot {\n  right: -12%;\n  bottom: -30%;\n  width: 86%;\n}\n\n@media (max-width: 640px) {\n  .cat-backdrop[data-variant=\"page\"] {\n    min-height: 34rem;\n  }\n\n  .cat-backdrop[data-variant=\"page\"]::after {\n    background: linear-gradient(180deg, var(--card) 0%, var(--card) 55%, transparent 82%);\n  }\n\n  .cat-backdrop[data-variant=\"page\"] .cat-backdrop__content {\n    width: 100%;\n    padding: 1.5rem;\n  }\n\n  .cat-backdrop[data-variant=\"page\"] .cat-backdrop__mascot {\n    right: -16%;\n    bottom: -8%;\n    width: 96%;\n  }\n\n  .cat-backdrop[data-variant=\"card\"] .cat-backdrop__mascot {\n    right: -18%;\n    bottom: -22%;\n    width: 100%;\n  }\n}\n\n@media (prefers-reduced-motion: no-preference) {\n  .cat-backdrop__mascot {\n    transition: transform var(--motion-duration) var(--motion-easing);\n  }\n\n  .cat-backdrop:hover .cat-backdrop__mascot {\n    transform: translateY(-0.25rem);\n  }\n}\n"
    },
    {
      "path": "src/components/custom/cat-mascot-data.ts",
      "target": "src/components/custom/cat-mascot-data.ts",
      "type": "registry:component",
      "content": "const catMascot = \"data:image/webp;base64,\"\n\nexport default catMascot\n"
    }
  ],
  "dependencies": [
    "cn@0.3.0"
  ]
}
