{
  "name": "Ember Orbit",
  "slug": "ember-orbit",
  "mode": "dark",
  "colors": {
    "background": "#050403",
    "foreground": "#F4E7C9",
    "card": "#0B0704",
    "card-foreground": "#F4E7C9",
    "popover": "#100A05",
    "popover-foreground": "#FFF3D6",
    "primary": "#F05A14",
    "primary-foreground": "#190700",
    "secondary": "#211307",
    "secondary-foreground": "#F8C46A",
    "muted": "#171009",
    "muted-foreground": "#C9AA74",
    "accent": "#F5A21A",
    "accent-foreground": "#170900",
    "destructive": "#FF6048",
    "border": "#814313",
    "input": "#A75718",
    "ring": "#FFB43B",
    "chart-1": "#F05A14",
    "chart-2": "#F5A21A",
    "chart-3": "#FFD06A",
    "chart-4": "#B55319",
    "chart-5": "#7F2B12",
    "sidebar": "#080503",
    "sidebar-foreground": "#EFD8A9",
    "sidebar-primary": "#F05A14",
    "sidebar-primary-foreground": "#190700",
    "sidebar-accent": "#241306",
    "sidebar-accent-foreground": "#FFC661",
    "sidebar-border": "#71390F",
    "sidebar-ring": "#FFB43B"
  },
  "radius": 2,
  "font": {
    "family": "Inter, sans-serif",
    "heading": "Rajdhani, sans-serif",
    "bodySize": 16,
    "headingWeight": 600
  },
  "spacing": {
    "unit": 4,
    "controlHeight": 48
  },
  "icons": {
    "family": "Lucide geometric",
    "size": 20,
    "stroke": 1.5
  },
  "motion": {
    "duration": 180,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "shadow": "0 18px 48px rgba(33, 9, 0, 0.42)",
  "craft": {
    "controlRadius": 2,
    "surfaceRadius": 2,
    "overlayRadius": 2,
    "bodyLineHeight": 1.65,
    "headingLineHeight": 0.96,
    "headingTracking": 0.03,
    "labelWeight": 600,
    "controlPadding": 18,
    "iconGap": 10
  },
  "signature": {
    "actions": {
      "shadow": "none",
      "borderWidth": 1,
      "pressedOffset": 1
    },
    "inputs": {
      "shadow": "none",
      "borderWidth": 1
    },
    "selection": {
      "shadow": "none",
      "borderWidth": 1,
      "pressedOffset": 0
    },
    "navigation": {
      "shadow": "none",
      "borderWidth": 1,
      "pressedOffset": 0
    },
    "data-display": {
      "shadow": "none",
      "borderWidth": 1
    },
    "overlays": {
      "shadow": "0 18px 48px rgba(33, 9, 0, 0.52)",
      "borderWidth": 1
    },
    "feedback": {
      "shadow": "none",
      "borderWidth": 1,
      "accentWidth": 2
    }
  },
  "rationale": "The reference centers a near-black canvas, dense edge telemetry, and an open orbital focus. Amber carries information while ember orange is reserved for actions and selection. Everyday components remain flat and line-led; circular geometry is concentrated in status cues and the Key Visual."
}
