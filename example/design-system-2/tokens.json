{
  "name": "星潮工作台",
  "slug": "starry-current",
  "mode": "dark",
  "colors": {
    "background": "#071532",
    "foreground": "#F4F0D8",
    "card": "#0D2250",
    "card-foreground": "#F4F0D8",
    "popover": "#132B5F",
    "popover-foreground": "#F4F0D8",
    "primary": "#E5C94A",
    "primary-foreground": "#10204A",
    "secondary": "#17366F",
    "secondary-foreground": "#F4F0D8",
    "muted": "#10275A",
    "muted-foreground": "#AFC2E8",
    "accent": "#79B7C9",
    "accent-foreground": "#071532",
    "destructive": "#FF7B7B",
    "border": "#385A93",
    "input": "#4E70A8",
    "ring": "#F2D665",
    "chart-1": "#E5C94A",
    "chart-2": "#79B7C9",
    "chart-3": "#8297E3",
    "chart-4": "#B4DFA3",
    "chart-5": "#F49B73",
    "sidebar": "#050D24",
    "sidebar-foreground": "#F4F0D8",
    "sidebar-primary": "#E5C94A",
    "sidebar-primary-foreground": "#10204A",
    "sidebar-accent": "#10275A",
    "sidebar-accent-foreground": "#F4F0D8",
    "sidebar-border": "#263F72",
    "sidebar-ring": "#F2D665",
    "success": "#8FCFAD",
    "warning": "#F2C66D",
    "info": "#8BC7E6"
  },
  "radius": 16,
  "font": {
    "family": "'Noto Sans SC Variable', 'Noto Sans SC', system-ui, sans-serif",
    "heading": "'Noto Serif SC Variable', 'Noto Serif SC', serif",
    "bodySize": 16,
    "headingWeight": 700
  },
  "spacing": {
    "unit": 4,
    "controlHeight": 46
  },
  "icons": {
    "family": "Lucide rounded outline",
    "size": 20,
    "stroke": 1.75
  },
  "motion": {
    "duration": 160,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "shadow": "0 22px 50px #02081666",
  "craft": {
    "controlRadius": 10,
    "surfaceRadius": 20,
    "overlayRadius": 24,
    "bodyLineHeight": 1.65,
    "headingLineHeight": 1.08,
    "headingTracking": -0.025,
    "labelWeight": 600,
    "controlPadding": 18,
    "iconGap": 8
  },
  "signature": {
    "actions": {
      "shadow": "0 8px 24px #02081666",
      "borderWidth": 1,
      "pressedOffset": 1
    },
    "inputs": {
      "shadow": "inset 0 1px 0 #ffffff0a",
      "borderWidth": 1
    },
    "selection": {
      "shadow": "none",
      "borderWidth": 1,
      "pressedOffset": 0
    },
    "navigation": {
      "shadow": "none",
      "borderWidth": 1,
      "pressedOffset": 0
    },
    "data-display": {
      "shadow": "0 12px 34px #02081633",
      "borderWidth": 1
    },
    "overlays": {
      "shadow": "0 28px 70px #02081680",
      "borderWidth": 1
    },
    "feedback": {
      "shadow": "0 16px 38px #02081655",
      "borderWidth": 1,
      "accentWidth": 3
    }
  },
  "rationale": "图像以大面积深蓝承托少量暖黄焦点，后台以侧栏和清晰边界保持稳定，营销展示区才使用有机弧线与方向性纹理。"
}
